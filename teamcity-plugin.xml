<?xml version="1.0" encoding="UTF-8"?>
<teamcity-plugin xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:schemas-jetbrains-com:teamcity-plugin-v1-xml">
  <info>
    <name>teamcity-oidc-auth</name>
    <display-name>Duende IdentityServer Authentication</display-name>
    <version>@Version@</version>
    <description>Authenticate existing TeamCity users with Duende IdentityServer using OpenID Connect and S256 PKCE.</description>
    <vendor>
      <name>@VendorName@</name>
      <url>@VendorURL@</url>
    </vendor>
  </info>
  <deployment use-separate-classloader="true" node-responsibilities-aware="true" allow-runtime-reload="true"/>
</teamcity-plugin>
